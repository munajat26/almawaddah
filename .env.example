# URL Web App hasil Deploy Google Apps Script (berakhiran /exec)
GAS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Harus sama persis dengan Script Property API_KEY di GAS
GAS_API_KEY=ganti-dengan-kunci-acak-panjang

# Alamat publik situs (tanpa garis miring di akhir), dipakai untuk gambar pratinjau saat link dibagikan
NEXT_PUBLIC_SITE_URL=https://domain-anda.com
